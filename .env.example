# Copy this file to .env.local and fill it in. Never commit .env.local.
# Leave a section empty to keep showing sample data for that source.

# --- Auth.js (Google sign-in, @hanini.com only) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only accounts on this domain can sign in
AUTH_ALLOWED_DOMAIN=hanini.com

# --- Zoho Projects + Zoho CRM (one Self Client, refresh token covers both scopes) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center: com (US), eu, in, com.au, jp, ca, sa
ZOHO_DC=com
ZOHO_PORTAL_ID=854982967

# --- Google Sheets + Drive (service account) ---
# Paste the whole JSON key on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
ROSTER_SPREADSHEET_ID=1h-64cziAfN6mlFV0nv_2m_DoNnB2BoUqiKVobIkWqQI
ROSTER_SHEET_TAB_ID=401964840
# Optional: email for domain-wide delegation — the service account then acts
# as this user in Drive/Docs (needs the Workspace admin to authorize the
# service account's client ID for the Drive + Docs readonly scopes). Without
# it, the dashboard only sees files shared directly with the service account.
# GOOGLE_IMPERSONATE_USER=samer@hanini.com

# --- QuickBooks Online (UrbanCore Builders LLC) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# First refresh token only. QuickBooks rotates it, so the newest one is stored in KV (below).
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# sandbox or production
QBO_ENVIRONMENT=production

# --- Token storage for the rotating QuickBooks refresh token (Vercel KV / Upstash Redis) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
